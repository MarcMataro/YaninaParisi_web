digraph ExplorerTree {
  // Strict top-down (vertical) tree like Windows Explorer
  rankdir=TB;
  splines=ortho;
  nodesep=0.35;
  ranksep=0.5;
  margin=0.05;

  node [fontname="Segoe UI" fontsize=10];
  edge [arrowhead=none color="#666666" fontsize=9];

  // Root (site root)
  root [label="yaninaparisi.com\nindex.php" shape=folder style=filled fillcolor="#FFF3E0" color="#FFB74D"];

  // Top-level folders (each shown as a folder node)
  ca [label="/ca" shape=folder style=filled fillcolor="#E8F5E9" color="#66BB6A"];
  es [label="/es" shape=folder style=filled fillcolor="#FFEBEE" color="#EF5350"];
  pcontrol [label="/_pcontrol" shape=folder style=filled fillcolor="#F3E5F5" color="#CE93D8"];
  classes [label="/classes" shape=folder style=filled fillcolor="#FFE0B2" color="#FFB74D"];
  includes [label="/includes" shape=folder style=filled fillcolor="#FFF9C4" color="#FFD54F"];
  assets [label="/assets\n(css, js, img)" shape=folder style=filled fillcolor="#BBDEFB" color="#64B5F6"];

  // Public: Català branch (children as files/folders)
  ca_home [label="home.php" shape=note style=filled fillcolor="#A5D6A7"];
  ca_sobremi [label="sobremi.php" shape=note];
  ca_clinica [label="clinica.php" shape=note];
  ca_contacta [label="contacta.php" shape=note];
  ca_blog [label="/blog" shape=folder style=filled fillcolor="#C8E6C9"];
  ca_blog_home [label="blog.php" shape=note];
  ca_entrada [label="entrada.php" shape=note];
  ca_faq [label="faq.php" shape=note];
  ca_lovematch [label="love-match.php" shape=note];
  ca_opina [label="opina.php" shape=note];

  // Public: Español branch
  es_home [label="home.php" shape=note style=filled fillcolor="#EF9A9A"];
  es_sobremi [label="sobremi.php" shape=note];
  es_clinica [label="clinica.php" shape=note];
  es_contacta [label="contacta.php" shape=note];
  es_blog [label="/blog" shape=folder style=filled fillcolor="#FFCDD2"];
  es_blog_home [label="blog.php" shape=note];
  es_entrada [label="entrada.php" shape=note];
  es_faq [label="faq.php" shape=note];
  es_lovematch [label="love-match.php" shape=note];
  es_opina [label="opina.php" shape=note];

  // _pcontrol (admin) contents - independent branch
  pc_index [label="index.php" shape=note];
  pc_dashboard [label="dashboard.php" shape=note];
  pc_gblog [label="gblog.php" shape=note];
  pc_gmedia [label="gmedia.php" shape=note];
  pc_gpacients [label="gpacients.php" shape=note];
  pc_config [label="configuracion.php" shape=note];
  pc_fact [label="facturacion.php" shape=note];

  // Other infra
  db [label="database" shape=cylinder style=filled fillcolor="#FFE0B2"];
  sitemap [label="sitemap.xml" shape=note style=filled fillcolor="#FFF9C4"];
  robots [label="robots.txt" shape=note style=filled fillcolor="#FFF9C4"];

  // --- Tree edges: strict parent -> children, no cross-language edges ---
  root -> ca;
  root -> es;
  root -> pcontrol;
  root -> classes;
  root -> includes;
  root -> assets;

  // Català branch
  ca -> ca_home;
  ca -> ca_sobremi;
  ca -> ca_clinica;
  ca -> ca_contacta;
  ca -> ca_blog;
  ca_blog -> ca_blog_home;
  ca_blog -> ca_entrada;
  ca -> ca_faq;
  ca -> ca_lovematch;
  ca -> ca_opina;

  // Español branch
  es -> es_home;
  es -> es_sobremi;
  es -> es_clinica;
  es -> es_contacta;
  es -> es_blog;
  es_blog -> es_blog_home;
  es_blog -> es_entrada;
  es -> es_faq;
  es -> es_lovematch;
  es -> es_opina;

  // _pcontrol branch (independent)
  pcontrol -> pc_index;
  pcontrol -> pc_dashboard;
  pcontrol -> pc_gblog;
  pcontrol -> pc_gmedia;
  pcontrol -> pc_gpacients;
  pcontrol -> pc_config;
  pcontrol -> pc_fact;

  // Backend & resources
  classes -> db;
  includes -> db;
  assets -> sitemap;
  assets -> robots;

  // Visual grouping: keep /ca and /es side-by-side but separate branches (no crossing)
  { rank=same; ca; es; pcontrol; classes; includes; assets; }

  // Note: hreflang relationships are represented as textual hints in folder labels to avoid crossing lines.
}
